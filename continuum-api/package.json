{
  "name": "q64-continuum-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply q64-continuum --local",
    "db:migrate:stage": "wrangler d1 migrations apply q64-continuum-stage --remote --env stage",
    "db:migrate:prod": "wrangler d1 migrations apply q64-continuum --remote --env prod",
    "deploy:stage": "wrangler deploy --env stage",
    "deploy:prod": "wrangler deploy --env prod",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/"
  },
  "dependencies": {
    "hono": "^4.12.22",
    "json5": "^2.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260523.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.94.0"
  }
}
