// Vendored from WebAssembly/wasi-config (wit/store.wit).
// Package wasi:config@0.2.0-draft — the env.config capability target
// (spec/env.md §`env.config`). Read-only application configuration / secrets,
// keyed by string. Unlike wasi:keyvalue / q64:blob / q64:db, `get` and
// `get-all` are TOP-LEVEL interface functions (no bucket/connection resource,
// no host `open` step) — the host scopes config to the qube's identity itself.

package wasi:config@0.2.0-draft;

/// An interface for getting configuration values.
interface store {
    /// An error type that encapsulates the different errors that can occur
    /// fetching configuration values.
    variant error {
        /// This indicates an error from an "upstream" config source.
        /// As this could be almost _anything_ (such as Vault, Kubernetes
        /// ConfigMaps, KeyValue buckets, etc), the error message is a string.
        upstream(string),
        /// This indicates an error from an I/O operation.
        /// As this could be almost _anything_ (such as a file read, network
        /// connection, etc), the error message is a string.
        io(string),
    }

    /// Gets a single opaque config value set at the given key if it exists.
    get: func(key: string) -> result<option<string>, error>;

    /// Gets a list of all set config data.
    get-all: func() -> result<list<tuple<string, string>>, error>;
}
