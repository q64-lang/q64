{
  "name": "q64-vscode",
  "displayName": "q64",
  "description": "q64 language support — diagnostics, and (as the toolchain grows) hover, go-to-definition, and formatting.",
  "version": "0.0.0",
  "private": true,
  "publisher": "q64",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Programming Languages"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "q64",
        "aliases": ["q64", "Q64"],
        "extensions": [".q"],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@q64/server": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
