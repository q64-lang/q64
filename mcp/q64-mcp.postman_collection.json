{
  "info": {
    "name": "q64-mcp",
    "description": "Manual Streamable-HTTP MCP test calls for q64-mcp (baseUrl variable = https://q64-mcp.tech41.workers.dev/mcp; swap to https://mcp.q64.dev/mcp once that custom domain's DNS is live). Run the requests top-to-bottom: Initialize captures the session id automatically; the rest reuse it.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://q64-mcp.tech41.workers.dev/mcp" },
    { "key": "mcpSessionId", "value": "" }
  ],
  "item": [
    {
      "name": "1. initialize",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const sid = pm.response.headers.get('mcp-session-id');",
              "if (sid) { pm.collectionVariables.set('mcpSessionId', sid); console.log('captured session', sid); }",
              "pm.test('got serverInfo', () => pm.expect(pm.response.text()).to.include('serverInfo'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json, text/event-stream" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"postman\",\"version\":\"1.0\"}}}"
        },
        "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] }
      }
    },
    {
      "name": "2. notifications/initialized",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json, text/event-stream" },
          { "key": "Mcp-Session-Id", "value": "{{mcpSessionId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}"
        },
        "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] }
      }
    },
    {
      "name": "3. tools/list",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json, text/event-stream" },
          { "key": "Mcp-Session-Id", "value": "{{mcpSessionId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{}}"
        },
        "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] }
      }
    },
    {
      "name": "4. tools/call version",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json, text/event-stream" },
          { "key": "Mcp-Session-Id", "value": "{{mcpSessionId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"version\",\"arguments\":{}}}"
        },
        "url": { "raw": "{{baseUrl}}", "host": ["{{baseUrl}}"] }
      }
    }
  ]
}
